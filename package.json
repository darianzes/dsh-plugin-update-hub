{
  "name": "dsh-plugin-update-hub",
  "version": "0.1.1",
  "description": "已安装插件版本中枢：一次并发检查所有插件的落后情况，展示安装时间与可升级版本，按版本批量排队升级并实时显示进度。",
  "icon": "icon.png",
  "license": "MIT",
  "author": "darianzes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darianzes/dsh-plugin-update-hub.git"
  },
  "homepage": "https://github.com/darianzes/dsh-plugin-update-hub#readme",
  "bugs": {
    "url": "https://github.com/darianzes/dsh-plugin-update-hub/issues"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host.mjs && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "client-plugin",
    "plugin-manager",
    "update",
    "upgrade",
    "versions"
  ]
}